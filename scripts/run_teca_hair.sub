LOG_PREFIX = /home/hzhang/logs/teca/$(Cluster).$(Process)
output  = $(LOG_PREFIX).out
error   = $(LOG_PREFIX).err
log     = $(LOG_PREFIX).log

request_memory          = 32000M
request_cpus            = 4
request_gpus            = 1
request_disk            = 30G

on_exit_remove = (ExitBySignal == False) && (ExitCode == 0)
requirements = (TARGET.CUDAGlobalMemoryMb>30000) && (Machine =!= LastRemoteHost)
# max_retries    = 3
getenv = True

+MaxRunningPrice = 100
+RunningPriceExceededAction = "restart"

executable = scripts/run_teca_hair.sh
arguments = $(script) $(seed) $(B) $(C) $(D)

